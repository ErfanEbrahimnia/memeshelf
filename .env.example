# Convex (from `npx convex dev`)
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=

# Meme metadata enrichment (Convex env — synced from this file when using `pnpm dev`)
# Default: real AI. For local dev without API usage:
MEME_AI_MOCK=true

# Required when MEME_AI_MOCK is unset or false (set in Convex dashboard for deployed envs)
# AI_GATEWAY_API_KEY=
