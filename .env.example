# ------------------------------------------------------------------------------
# Next.js (local — written by `pnpm exec convex dev` / `pnpm dev`)
# ------------------------------------------------------------------------------
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ------------------------------------------------------------------------------
# Convex deployment environment (Dashboard or `npx convex env set`)
# Not stored in this file for production; listed here for discoverability.
# ------------------------------------------------------------------------------
#
# Auth (@convex-dev/auth + Google) — required for sign-in:
#   SITE_URL=http://localhost:3000
#   JWT_PRIVATE_KEY=...
#   JWKS=...
#   AUTH_GOOGLE_ID=...
#   AUTH_GOOGLE_SECRET=...
#
# See https://labs.convex.dev/auth/setup

# ------------------------------------------------------------------------------
# Meme metadata enrichment (Convex env — synced from .env.local when using
# `pnpm dev` via convex/convex.config.ts)
# ------------------------------------------------------------------------------
# Use mock enrichment locally (no AI Gateway usage):
MEME_AI_MOCK=true

# When MEME_AI_MOCK is unset or false, set on the Convex deployment:
# AI_GATEWAY_API_KEY=
